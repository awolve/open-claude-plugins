{
  "description": "Awolve Signum — keep spec files in sync with the service",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/specs-cli.py hook session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/specs-cli.py hook post-tool-use",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
